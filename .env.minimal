# OpenFB — Minimal working configuration
# Copy to .env and edit:
#   cp .env.minimal .env

HOST=0.0.0.0
PORT=3000
API_KEY=change-me-to-a-random-string
JWT_SECRET=change-me-to-another-random-string

# Camoufox engine — start simple
CAMOUFOX_HEADLESS=true
CAMOUFOX_HUMANIZE=true
CAMOUFOX_OS=windows
CAMOUFOX_USER_DATA_DIR=./data/profiles

# Allow 3 concurrent Facebook sessions
MAX_SESSIONS=3
SESSION_IDLE_TIMEOUT=30

# Rate limiting
RATE_LIMIT_MESSAGES_PER_MIN=60

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
