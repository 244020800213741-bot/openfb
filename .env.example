# ─────────────────────────────────────────────
#  OpenFB — Environment Configuration
# ─────────────────────────────────────────────

# ── Server ──
HOST=0.0.0.0
PORT=3000

# ── Security ──
API_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string

# ── Camoufox Engine ──
# Path to the Camoufox binary (leave empty to auto-detect via `camoufox path`)
CAMOUFOX_BINARY=
# Run browser headless (true | false | virtual)
CAMOUFOX_HEADLESS=true
# Human-like cursor movement (true | false | max-seconds-float)
CAMOUFOX_HUMANIZE=true
# OS for fingerprint generation (windows | macos | linux | comma-separated list)
CAMOUFOX_OS=windows
# Proxy configuration (leave empty for direct connection)
# Format: protocol://user:pass@host:port
CAMOUFOX_PROXY=
# GeoIP: pass an IP to spoof geolocation, or "auto" to detect from proxy
CAMOUFOX_GEOIP=
# User data directory for persistent sessions (profile cookies, logins)
CAMOUFOX_USER_DATA_DIR=./data/profiles
# Window size (widthxheight) — empty = randomised by Camoufox
CAMOUFOX_WINDOW_SIZE=
# Locale (e.g. en-US, es-ES)
CAMOUFOX_LOCALE=

# ── Session management ──
# Max concurrent Facebook sessions
MAX_SESSIONS=5
# Session idle timeout in minutes (0 = never)
SESSION_IDLE_TIMEOUT=30

# ── Webhooks ──
# Default webhook URL for incoming events
WEBHOOK_URL=
# Secret for signing webhook payloads
WEBHOOK_SECRET=

# ── Queue / Rate limiting ──
# Max messages per minute per session
RATE_LIMIT_MESSAGES_PER_MIN=60
# Queue concurrency
QUEUE_CONCURRENCY=1

# ── Dashboard ──
DASHBOARD_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
